APP_NAME=Knowledge Evolution Engine
# Local demo: sqlite+pysqlite:///./data/kee.db
# Docker compose stack (default host ports remapped to avoid conflicts):
DATABASE_URL=postgresql+psycopg://kee:kee@127.0.0.1:15432/kee
CORS_ORIGINS=http://localhost:3030,http://127.0.0.1:3030
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
ENABLE_NEO4J_SYNC=true
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kee-password
REDIS_URL=redis://127.0.0.1:16379/0
# MCP plugin: leave KEE_API_BASE empty for in-process (same DB as this backend).
# Set to http://127.0.0.1:8306 to call HTTP instead; optional Bearer key:
KEE_API_BASE=
KEE_API_KEY=
